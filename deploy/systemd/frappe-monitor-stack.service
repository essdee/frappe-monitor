[Unit]
Description=Frappe Monitor backing stack (VictoriaMetrics + Loki)
Documentation=https://github.com/sakthikumarp/frappe_monitor
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=true
WorkingDirectory=/opt/frappe-monitor/deploy
# Docker may come from apt (/usr/bin/docker), upstream packages
# (/usr/local/bin/docker), or Snap (/snap/bin/docker). Use a fixed, explicit
# service PATH instead of depending on a distro-specific docker.service unit.
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin"
ExecStartPre=/bin/sh -c 'i=0; until docker info >/dev/null 2>&1; do i=$$((i+1)); [ "$$i" -ge 30 ] && exit 1; sleep 1; done'
# Snap confinement cannot open Compose files under /opt. Let the unrestricted
# system shell open the YAML and stream it to Compose; -p supplies the stable
# project name that Compose cannot derive when the config source is stdin.
ExecStart=/bin/sh -c 'exec docker compose --project-name frappe-monitor -f - up -d < docker-compose.prod.yml'
ExecStop=/bin/sh -c 'exec docker compose --project-name frappe-monitor -f - down < docker-compose.prod.yml'
TimeoutStartSec=180s

[Install]
WantedBy=multi-user.target
